// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid())
  name            String    @db.VarChar(255)
  email           String    @unique
  password        String    @db.VarChar(255)
  role            UserRole  @default(USER)
  isEmailVerified Boolean   @default(false)
  dob             DateTime?
  martialStatus   String?   @db.VarChar(255)
  maritalStatus   String?   @db.VarChar(255)
  motive          String?   @db.VarChar(255)
  spendMostly     String?   @db.VarChar(255)
  spendMostlyOn   String?   @db.VarChar(255)
  income          Float     @default(0)
  avatarUrl       String?   @db.VarChar(500)
  theme           String?   @default("dark") @db.VarChar(50)
  currency        String?   @default("USD ($)") @db.VarChar(50)
  notifications   Boolean   @default(true)
  biometric       Boolean   @default(true)
  twoFactor       Boolean   @default(false)
  aiNudges        Boolean   @default(true)
  goals           Goal[]
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  Token           Token[]
  budgets         Budget[]
  transactions    Transaction[]
  userContacts    UserContact[]

  @@map("users")
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum GoalType {
  EMERGENCY_FUND
  VACATION
  CAR
  HOME
  GADGET
  EDUCATION
  INVESTMENT
  CUSTOM
}

enum AutomationFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum GoalCreatedVia {
  MANUAL
  AI_PLAN
}

model Goal {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goalName String
  goalType GoalType @default(CUSTOM)

  coverImage String?

  targetAmount       Decimal @db.Decimal(12, 2)
  currentSavedAmount Decimal @default(0) @db.Decimal(12, 2)

  targetDate DateTime?

  projectedCompletionDate DateTime?

  status GoalStatus @default(ACTIVE)

  smartSaverEnabled Boolean @default(false)

  automationMinBalance Decimal? @db.Decimal(12, 2)

  automationFrequency AutomationFrequency?

  createdVia GoalCreatedVia @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Token {
  id          String    @id @default(uuid())
  token       String    @db.Text
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TokenType
  expires     DateTime
  blacklisted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([token])
  @@map("tokens")
}

model Budget {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category String
  amount   Float  @default(0)
  limit    Float  @default(0)

  transactions Transaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, category]) // ← this is the key line
  @@index([userId])
  @@map("budgets")
}

enum UserRole {
  USER
  ADMIN
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}

// ─── Transaction Enums ───────────────────────────────────────────────────────

enum TransactionSource {
  PDF
  SMS
  BANK_API
  MANUAL
}

enum TransactionType {
  FIXED
  RECURRING
  VARIABLE
  WEALTH_MOVEMENT
}

enum TransactionDirection {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionCategory {
  // FIXED
  RENT
  MORTGAGE
  INSURANCE
  SUBSCRIPTION
  EMI
  SALARY
  // RECURRING
  UTILITIES
  INTERNET
  MOBILE_PLAN
  GYM
  STREAMING
  SIP
  // VARIABLE
  FOOD
  SHOPPING
  ENTERTAINMENT
  TRAVEL
  HEALTHCARE
  FUEL
  // WEALTH_MOVEMENT
  TRANSFER
  INVESTMENT
  WITHDRAWAL
  TOP_UP
  DIVIDEND
  // Shared
  OTHER
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  NONE
}

// ─── Transaction Model ───────────────────────────────────────────────────────

model Transaction {
  id          String               @id @default(uuid())
  userId      String               @map("user_id")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String               @db.VarChar(255)
  description String?              @db.Text
  amount      Decimal              @db.Decimal(12, 2)

  type        TransactionType
  direction   TransactionDirection
  category    TransactionCategory

  recurrence  RecurrenceFrequency  @default(NONE)

  // The date the transaction occurred or is scheduled
  date        DateTime

  // Optional link to a budget category
  budgetId    String?              @map("budget_id")
  budget      Budget?              @relation(fields: [budgetId], references: [id], onDelete: SetNull)

  note        String?              @db.Text

  // Import metadata
  source      TransactionSource    @default(MANUAL)
  importFingerprint String?        @unique @map("import_fingerprint")

  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@index([type])
  @@index([direction])
  @@index([date])
  @@index([userId, date])
  @@index([userId, category])
  @@map("transactions")
}

// ─── Contact Models ───────────────────────────────────────────────────────────

model Contact {
  id           String        @id @default(uuid())
  phoneNumber  String        @unique @map("phone_number")
  name         String?       @db.VarChar(255)
  sources      String[]      @default([])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  userContacts UserContact[]

  @@index([phoneNumber])
  @@map("contacts")
}

model UserContact {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId   String   @map("contact_id")
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(255)
  phoneNumber String   @map("phone_number") @db.VarChar(50)
  emails      String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, phoneNumber])
  @@index([userId])
  @@index([phoneNumber])
  @@map("user_contacts")
}
